# Supabase PostgreSQL connection string
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres

# Flask secret key (REQUIRED in production; never commit a real secret)
# Generate a cryptographically secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-local-only

# Flask environment
FLASK_ENV=development
FLASK_DEBUG=1
